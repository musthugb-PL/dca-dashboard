# ─────────────────────────────────────────────────────────────────────────────
# Campaign Optimisation Dashboard — environment template
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# git-ignored and must NEVER be committed. In production these same keys are
# set in the Vercel project (Settings → Environment Variables).
#
# All four values are SERVER-ONLY secrets — do not prefix with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (marketing project: kwftlkfvtglnugxsyjci, region ap-south-1)
SUPABASE_URL=https://kwftlkfvtglnugxsyjci.supabase.co
# Supabase → Project kwftlkfvtglnugxsyjci → Settings → API → service_role key.
# Server-only. Bypasses RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-key

# OpenRouter (AI gateway — one key, multi-model routing)
# openrouter.ai → Settings → Keys → Create.
OPENROUTER_API_KEY=replace-me-openrouter-key

# Google BigQuery service account (read-only, marketing dataset)
# project_id: platinumlist-1014
# Paste the base64-encoded service-account JSON key here.
# Wired at Phase 1b Task 5 (BQ smoke test) — placeholder is fine until then.
GCP_BQ_SERVICE_ACCOUNT_JSON=replace-me-base64-encoded-service-account-json
